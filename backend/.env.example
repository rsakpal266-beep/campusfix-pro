# CampusFix Pro Backend Environment Configuration
# Copy for local dev: cp .env.example .env

# PostgreSQL Connection:
# Either provide full DATABASE_URL or individual POSTGRES_* settings.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campusfix_pro
POSTGRES_PORT=5432

# Security & JWT
JWT_SECRET_KEY=campusfix-pro-secret-key-change-later-lime-green-2026

# Server Settings
PORT=5000
HOST=0.0.0.0
DEBUG=true
FRONTEND_URL=http://localhost:5173

# FixBot AI (Provide real API keys to enable live LLM generation)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
